# ── Copy to .env on your server and fill in every value ──────────────────────────
# Your domain WITHOUT https:// (Caddy uses it to get the HTTPS certificate)
DOMAIN=inklucus.com
APP_URL=https://inklucus.com

# Generate each secret with:  openssl rand -base64 48
POSTGRES_PASSWORD=change-me
SESSION_SECRET=change-me
CRON_SECRET=change-me

# Currency for prices and payments (ISO code)
CURRENCY=USD

# Email for password resets (any SMTP provider: Brevo, Mailgun, Postmark, Zoho, Gmail SMTP…)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="InkLucus <no-reply@inklucus.com>"

# Paynow (EcoCash / OneMoney / cards in Zimbabwe) – from your Paynow integration settings
PAYNOW_INTEGRATION_ID=
PAYNOW_INTEGRATION_KEY=
PAYNOW_AUTH_EMAIL=

# Stripe (international cards) – leave empty to disable
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Must stay false in production
PAYMENTS_DEV_MODE=false

# Business rules
GIFT_CARD_VALIDITY_DAYS=365
# % of gross sales deducted for platform costs before the author's royalty % is applied
ROYALTY_COST_DEDUCTION_PERCENT=0
# Raise if many users share one IP (e.g. 3 = triple the per-IP sign-up/login limits)
RATE_LIMIT_IP_MULTIPLIER=1
